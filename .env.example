# Glaux Markets product origin. Every link to the product reads from this.
VITE_MARKETS_URL=https://markets.useglaux.com

# Optional. When set, the hero loads this glTF/GLB instead of the procedural owl.
# Place the file in public/models/ and point at it with an absolute path, e.g.
#   VITE_OWL_MODEL_URL=/models/owl.glb
# Leave unset to use the built-in procedural owl (no network request is made).
VITE_OWL_MODEL_URL=
