{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "useglaux",
  "compatibility_date": "2026-08-05",

  // Assets only: there is no Worker script, so no "main" and no
  // compatibility_flags. not_found_handling is deliberately unset — the site is
  // a real multi-page build (/, /privacy/, /terms/), not an SPA, so unmatched
  // paths must 404 rather than silently return the homepage with a 200.
  "assets": {
    "directory": "./dist",
  },

  // No "build" block. Cloudflare Workers Builds already runs the build command
  // from the project settings; declaring one here runs the whole build a second
  // time inside wrangler.

  "observability": {
    "enabled": true,
  },
}
